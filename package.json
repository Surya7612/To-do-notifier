{
  "name": "todo-notifier",
  "version": "1.4.2",
  "private": true,
  "description": "Mac menu-bar todo companion with Goku pet, Pomodoro, and local Ollama tutoring",
  "main": "electron/main.cjs",
  "author": "Surya",
  "scripts": {
    "patch:electron-mic": "node scripts/patch-electron-mic.cjs",
    "predev": "npm run patch:electron-mic",
    "postinstall": "npm run patch:electron-mic",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --dir",
    "dist": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
    "install:app": "npm run pack && node scripts/install-to-applications.cjs"
  },
  "build": {
    "appId": "com.surya.todonotifier",
    "productName": "To-Do Notifier",
    "copyright": "Private use",
    "afterPack": "./scripts/after-pack-sign.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "build/tray.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "To-Do Notifier uses the microphone for Hey Goku wake phrases and tutor dictation. Speech is sent to OpenAI Whisper while voice is on."
      }
    }
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.9",
    "wait-on": "^8.0.3"
  }
}

# Dependencies & builds
node_modules/
dist/
dist-electron/
release/
*.tsbuildinfo

# Env / secrets — never commit keys
.env
.env.*
!.env.example
*.pem
*.p12
*.key
credentials*.json
**/app-data.json

# Local-only companion art overrides (optional)
src/assets/local/

# OS / editor
.DS_Store
.AppleDouble
.LSOverride
# The files macOS actually scatters, as opposed to the directory named above.
._*
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Merge and patch leftovers
*.orig
*.rej
*.bak

# Logs, caches & test output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.parcel-cache/
.turbo/
.eslintcache
coverage/
.nyc_output/

# Local data stores
*.sqlite
*.sqlite3
*.db

# Python / local tooling (sprite experiments, etc.)
.venv/
.venv-*/
__pycache__/
*.pyc

# Electron / packaging leftovers
*.asar
*.dmg
*.zip
*.blockmap
builder-effective-config.yaml
builder-debug.yml

# Xcode (native macOS app)
# Scoped to the Xcode project rather than a bare `build/`, which also matched
# the top-level build/ holding electron-builder's icons and entitlements — those
# are packaging *inputs* and must stay tracked.
DerivedData/
TodoCompanion/build/
.swiftpm/
# Signing identity is per-developer; see Local.xcconfig.example.
TodoCompanion/Local.xcconfig
# Crash reports from a native app under development.
*.ips
*.crash
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Old / unused asset dumps
public/ort/
sprites/
native/bin/

